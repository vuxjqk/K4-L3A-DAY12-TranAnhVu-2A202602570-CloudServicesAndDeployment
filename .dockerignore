# File này quyết định thứ KHÔNG được copy vào image (build context).

# Secrets — tuyệt đối không nướng vào image
.env
.env.*
!.env.example
*.pem
*.key

# Git & môi trường ảo — nặng và không cần trong image
.git
.gitignore
.github
.venv
venv
env

# Python cache / test artifacts
__pycache__
*.py[cod]
.pytest_cache
*.egg-info

# Không cần lúc chạy
tests
screenshots
solution
*.md
*.log
docker-compose.yml
Dockerfile
.dockerignore

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode
